<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for Microsoft.CodeCoverage.Console. Static instrumentation is the
     only mode that works on arm64, and it requires the MSVC compiler. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*(?:nspr|plc|plds)4[.]dll$</ModulePath>
      </Include>
    </ModulePaths>
    <EnableDynamicNativeInstrumentation>False</EnableDynamicNativeInstrumentation>
    <EnableStaticNativeInstrumentation>True</EnableStaticNativeInstrumentation>
  </CodeCoverage>
</Configuration>
